{
    "bin": {"pikareceiver": "jdeploy-bundle/jdeploy.js"},
    "author": "John Garner",
    "main": "index.js",
    "preferGlobal": true,
    "version": "1.0.0",
    "jdeploy": {
        "fallbackToUniversal": false,
        "generateLegacyBundles": false,
        "publishTargets": [{
            "name": "npm: github",
            "type": "NPM",
            "url": ""
        }],
        "javaVersion": "25",
        "permissions": [
            {
                "name": "documents_folder",
                "description": "Ability to save to the documents folder"
            },
            {
                "name": "desktop_folder",
                "description": "Ability to save to the desktop"
            },
            {
                "name": "local_network",
                "description": "Ability to scan the local network to detect PikaReader instances"
            }
        ],
        "jar": "target/PikaReceiver-0.5-jar-with-dependencies.jar",
        "javafx": true,
        "title": "Pikareceiver",
        "platformBundlesEnabled": false,
        "downloadPage": {"platforms": ["default"]}
    },
    "dependencies": {
        "command-exists-promise": "^2.0.2",
        "node-fetch": "2.6.7",
        "tar": "^4.4.8",
        "yauzl": "^2.10.0",
        "shelljs": "^0.8.4"
    },
    "license": "ISC",
    "name": "pikareceiver",
    "files": ["jdeploy-bundle"],
    "scripts": {"test": "echo \"Error: no test specified\" && exit 1"}
}